# ==========================================================================
# Versuitality — root env template. Copy to .env for local development.
# ==========================================================================

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=versuitality
POSTGRES_USER=versuitality
POSTGRES_PASSWORD=versuitality_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (used by Django Channels in later phases) ----------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Django API ------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-not-for-production-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# --- Next.js web -----------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Versuitality

# --- Notifications --------------------------------------------------------
# Leave blank in dev — the notifications app falls back to a console
# provider that logs each rendered email + WhatsApp body and stamps the
# Notification row as `sent` via `console:*` so the UI still works.
SENDGRID_API_KEY=
NOTIFICATION_EMAIL_FROM=orders@versuitality.com
NOTIFICATION_EMAIL_FROM_NAME=Versuitality
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# --- Object storage (stubs in dev) ----------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Hosted deployment (Cloud Run + Supabase) -----------------------------
# Not needed for local docker-compose; see OPERATIONS.md section 11.
# POSTGRES_SSLMODE=require            # hosted Postgres needs TLS
# POSTGRES_POOLER_MODE=transaction    # only when using a port-6543 transaction pooler
# REDIS_URL=rediss://...              # optional; without Redis/REDIS_HOST the API
#                                     # uses an in-memory channel layer (1 instance only)
# DJANGO_TRUST_ALL_HOSTS=1            # accept any Host header (Cloud Run only)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-web-origin
# SERVE_MEDIA_FROM_APP=1              # serve uploads from the (ephemeral) container disk
# SEED_OWNER_PASSWORD=                # read by `manage.py seed_owners` instead of --activate-with-password
