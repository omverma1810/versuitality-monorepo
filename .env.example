# ==========================================================================
# Versuitality — root env template. Copy to .env for local development.
# ==========================================================================

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=versuitality
POSTGRES_USER=versuitality
POSTGRES_PASSWORD=versuitality_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (used by Django Channels in later phases) ----------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Django API ------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-not-for-production-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ORIGINS=http://localhost:3000

# --- Next.js web -----------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Versuitality

# --- Notifications (stubs in dev) -----------------------------------------
SENDGRID_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Object storage (stubs in dev) ----------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
