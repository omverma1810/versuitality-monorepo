{
  "name": "versuitality-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Versuitality \u2014 internal bespoke tailoring operations platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @versuitality/web dev",
    "build": "pnpm --filter @versuitality/web build",
    "lint": "pnpm -r --parallel lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "source-map-js": ">=1.2.2",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^5": "^5.0.12",
      "js-yaml@^4": "^4.3.2",
      "browserslist@^4": "^4.28.7",
      "baseline-browser-mapping@^2": "^2.11.0",
      "postcss-selector-parser@^6": "^6.1.3",
      "postcss-selector-parser@^7": "^7.1.6"
    }
  }
}
